# 公证凭据示例，只用来照着填。
# 不要改这个文件，填好的那份在 ~/.config/quik/notary.env。
#
# 用个人团队 A747RQ7RTH。App 专用密码在 appleid.apple.com 的
# 「登录与安全」里生成，形如 abcd-efgh-ijkl-mnop，只显示一次。
#
# 注意：notarytool 不支持 @env: 这类凭据引用（那是 altool 的功能），
# 密码必须是字面值。它在请求期间会出现在 ps 里，只在这台机器上。

QUIK_NOTARY_APPLE_ID=you@example.com
QUIK_NOTARY_TEAM_ID=A747RQ7RTH
QUIK_NOTARY_PASSWORD=abcd-efgh-ijkl-mnop

# 备选：App Store Connect API key。按 Issuer 认团队，不受密码变更和
# 钥匙串重置影响。生成方式：appstoreconnect.apple.com 切到个人团队，
# 用户和访问 > 集成 > App Store Connect API > 团队密钥 > 生成密钥，
# 下载 AuthKey_XXXXXXXXXX.p8 放到 ~/.appstoreconnect/private_keys/。
# 三项都填了会优先用这条。
#QUIK_NOTARY_KEY_PATH=$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
#QUIK_NOTARY_KEY_ID=XXXXXXXXXX
#QUIK_NOTARY_ISSUER=00000000-0000-0000-0000-000000000000
