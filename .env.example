# 公证凭据示例，只用来照着填。
# 不要改这个文件，填好的那份在 ~/.config/quik/notary.env。
#
# 三项都要填，缺一项 package.sh 会在开始构建前退出，不会白跑。
# Apple ID 邮箱就是登录 developer.apple.com 的那个账号。
# Team ID 是这个个人团队的 ID，在钥匙串证书的 OU 字段里，也可以在
#   developer.apple.com > Membership 里看到。
# App 专用密码在 appleid.apple.com > 登录与安全 > App 专用密码 里生成，
#   格式像 abcd-efgh-ijkl-mnop。不要用账号本身的登录密码。

QUIK_NOTARY_APPLE_ID=you@example.com
QUIK_NOTARY_TEAM_ID=XXXXXXXXXX
QUIK_NOTARY_PASSWORD=abcd-efgh-ijkl-mnop
